versions/*/logs/
.stonecutter/

# IDE
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.classpath
.project
bin/

# Claude Code / local agent tooling (per-developer, may contain local paths)
.claude/

# Local credentials and developer-only environment overrides
.env
.env.*
!.env.example

# OS
.DS_Store
Thumbs.db

# Node (mcp-server)
node_modules/
dist/
*.log

# mcpfabric runtime config (contains auth token)
mcpfabric.config.json

# mcp-server compiled tests
.test-build/

# MCP bundle build output
.mcpb-stage/
dist-mcpb/
